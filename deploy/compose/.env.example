PUBLIC_HOST=census.dashbuddy.trotter.cloud
ACME_EMAIL=
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://postgres:5432/census
DATABASE_USER=census
# Must match POSTGRES_PASSWORD.
DATABASE_PASSWORD=change-me
OPERATOR_TOKEN_SHA256=
# Required (#85): 64 hex digits from `openssl rand -hex 32`. Every stored word hash is keyed under it. Keep a copy
# outside this host; never change it once the server has started (a new pepper is a new hash domain).
CENSUS_HASH_PEPPER=
# Optional (#81): the operator's X25519 public key, base64 X.509, printed by `java deploy/tools/QuarantineKey.java
# keygen <private-key-file>` on the operator's own machine. "Ask the developer" items are sealed to it; without it they
# are refused. The private key never comes here.
CENSUS_OPERATOR_PUBLIC_KEY=
CENSUS_IMAGE_TAG=latest
# Remove this line after copying to retain SERVER_VERSION baked into the image.
SERVER_VERSION=
# Operator listener address (#1181): the WireGuard address on AWS, loopback otherwise. /ops is only served here.
OPS_BIND_IP=127.0.0.1

# Shared lifecycle admission policy. Notifications remain disabled until the activation drill.
CENSUS_NOTIFICATIONS_ENABLED=false
CENSUS_MIN_FILTER_REV=1
