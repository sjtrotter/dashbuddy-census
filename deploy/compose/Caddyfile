{
    email {$ACME_EMAIL}
    # #1181: clients connecting to the operator site by IP literal send no SNI; behind Docker's port NAT the
    # connection's local address is the container's, so certificate selection needs this default.
    default_sni {$OPS_BIND_IP}
    # ADR-0011: NO client IP is ever retained — runtime errors included; liveness is observed through /healthz probes, not proxy logs
    log {
        output discard
    }
}

(hardened) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    # Access log is DISCARDED on purpose: no IP retention (ADR-0011).
    log {
        output discard
    }
}

(upstream) {
    reverse_proxy census:8080 {
        header_up -X-Forwarded-For
        header_up -Forwarded
        header_up -X-Real-IP
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
    }
}

# The public site: the client API only. /ops is not routed here at all (#1181) — the operator surface lives on
# the private listener below, so a stolen operator token is useless from the internet.
{$PUBLIC_HOST} {
    import hardened
    # vars_regexp on the raw decoded path, not `path`/`path_regexp`: both of those run on the CLEANED path, but
    # the proxy forwards the ORIGINAL URI and Ktor keeps dot-segments literally, so `/ops/../x` cleans to /x here
    # yet routes into /ops upstream (review, Astra, two rounds). {http.request.uri.path} is req.URL.Path as
    # received (decoded, uncleaned).
    @ops vars_regexp ops {http.request.uri.path} (?i)^/+ops(/|$)
    handle @ops {
        respond 404
    }
    handle {
        import upstream
    }
    # S3: per-IP rate limiting via caddy-ratelimit requires a custom Caddy build.
}

# The operator site (#1181): published by Compose only on OPS_BIND_IP (the WireGuard address 10.8.0.1 on AWS,
# loopback otherwise), with Caddy's internal CA — install its root certificate on the operator's devices
# (`docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt`). The VPN is the transport boundary;
# TLS keeps the session cookie's Secure attribute honest.
https://{$OPS_BIND_IP}:8443 {
    import hardened
    tls internal
    import upstream
}
