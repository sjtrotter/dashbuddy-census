{
    email {$ACME_EMAIL}
    # #1178: caddy-ratelimit is a non-standard directive; place it before the standard handlers.
    order rate_limit before basic_auth
    # #1181: clients connecting to the operator site by IP literal send no SNI; behind Docker's port NAT the
    # connection's local address is the container's, so certificate selection needs this default.
    default_sni {$OPS_BIND_IP}
    # ADR-0011: NO client IP is ever retained — runtime errors included; liveness is observed through /healthz probes, not proxy logs.
    # This DEFAULT logger also carries caddy-ratelimit's refusal line (`rate limit exceeded` with the peer address,
    # logger http.handlers.rate_limit) — the site logs below do NOT cover it. Removing this block re-enables that line.
    log {
        output discard
    }
}

(hardened) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    # Access log is DISCARDED on purpose: no IP retention (ADR-0011).
    log {
        output discard
    }
}

(upstream) {
    reverse_proxy census:8080 {
        header_up -X-Forwarded-For
        header_up -Forwarded
        header_up -X-Real-IP
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
    }
}

# The public site: the client API only. /ops is not routed here at all (#1181) — the operator surface lives on
# the private listener below, so a stolen operator token is useless from the internet.
{$PUBLIC_HOST} {
    import hardened
    # vars_regexp on the raw decoded path, not `path`/`path_regexp`: both of those run on the CLEANED path, but
    # the proxy forwards the ORIGINAL URI and Ktor keeps dot-segments literally, so `/ops/../x` cleans to /x here
    # yet routes into /ops upstream (review, Astra, two rounds). {http.request.uri.path} is req.URL.Path as
    # received (decoded, uncleaned).
    @ops vars_regexp ops {http.request.uri.path} (?i)^/+ops(/|$)
    handle @ops {
        respond 404
    }
    handle {
        import upstream
    }
    # #1178: per-address admission at the edge, so one source cannot starve every driver's enrol/ingest (the app's
    # buckets are keyed by the bearer's UNVERIFIED install id, and enrol is one process-wide 120/h bucket spent
    # BEFORE credential checks). The client address is the direct TCP peer (nothing is in front of Caddy), held
    # ONLY in this plugin's in-memory zones — no access log, no retention, lost on restart (ADR-0011). Figures
    # (reviews, Astra + fable): enrol 10/min burst AND 20/h — one address can take at most a sixth of the app's
    # 120/h enrol bucket (a device enrols once; a refusal is only a deferral); ALL of /v1 (the enrol request spends
    # both zones) at 200/min — ~66 phones behind one carrier address can each run a three-batch upload in the same
    # minute, and it takes three addresses to drain the app's 600/min global admission (the app-side scope of that
    # bucket is the real weakness; edge limits only price the attack). Memory: a key costs ~2 KB until the sweep;
    # the 96 MiB cgroup absorbs tens of thousands of distinct addresses per sweep window — a real IPv4 pool is the
    # remaining DoS mode, accepted at this scale. The key is the bare peer address (/128 for IPv6): revisit before
    # any AAAA record (the host is IPv4-only today). Not a defence against a distributed source.
    rate_limit {
        zone enroll_burst {
            match {
                path /v1/enroll
            }
            key {http.request.remote.host}
            events 10
            window 1m
        }
        zone enroll_hourly {
            match {
                path /v1/enroll
            }
            key {http.request.remote.host}
            events 20
            window 1h
        }
        zone api {
            match {
                path /v1/*
            }
            key {http.request.remote.host}
            events 200
            window 1m
        }
        jitter 0.1
        sweep_interval 15s
    }
}

# The operator site (#1181): published by Compose only on OPS_BIND_IP (the WireGuard address 10.8.0.1 on AWS,
# loopback otherwise), with Caddy's internal CA — install its root certificate on the operator's devices
# (`docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt`). The VPN is the transport boundary;
# TLS keeps the session cookie's Secure attribute honest.
https://{$OPS_BIND_IP}:8443 {
    import hardened
    tls internal
    import upstream
}
