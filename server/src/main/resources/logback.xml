<configuration>
    <conversionRule conversionWord="safeEx" converterClass="cloud.trotter.census.server.SafeThrowableConverter"/>
    <!-- Day precision only; no MDC, caller address, credentials, or request body. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd,UTC} %-5level %logger{36} - %msg%nopex%n%safeEx</pattern>
        </encoder>
    </appender>
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.postgresql" level="OFF"/>
    <!-- Exposed failure diagnostics can render bound identifiers and JSON. -->
    <logger name="Exposed" level="OFF"/>
    <logger name="org.jetbrains.exposed" level="OFF"/>
    <logger name="io.ktor.server.plugins.ratelimit" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
